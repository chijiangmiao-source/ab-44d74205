#!/usr/bin/env bash
# One-shot acceptance for the ground-calibration spreadsheet.
#
# Runs, interleaved:
#   1. build check (Python byte-compilation, docker-compose validation if any)
#   2. code tests (branch-aware model unit tests)
#   3. page + health API/HTTP smoke (condition switch / partial publish /
#      failure rollback scenarios driven through the real HTTP server)
#
# Exits 0 only if every stage passes.  The server is shut down afterwards.
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

PYTHON="${PYTHON:-python3}"
PORT="${APP_PORT:-$($PYTHON -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()')}"
BASE_URL="http://127.0.0.1:${PORT}"
SERVER_PID=""

red()   { printf '\033[31m%s\033[0m\n' "$*"; }
green() { printf '\033[32m%s\033[0m\n' "$*"; }
step()  { printf '\n\033[1;36m== %s ==\033[0m\n' "$*"; }

cleanup() {
  if [ -n "$SERVER_PID" ] && kill -0 "$SERVER_PID" 2>/dev/null; then
    kill "$SERVER_PID" 2>/dev/null || true
    wait "$SERVER_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT

fail=0

step "1/4 构建检查：字节码编译"
if "$PYTHON" -m compileall -q app tests; then
  green "编译通过"
else
  red "编译失败"; exit 1
fi

if command -v docker >/dev/null 2>&1; then
  if docker compose version >/dev/null 2>&1; then
    step "1b/4 构建检查：docker compose 配置校验"
    if APP_PORT="$PORT" docker compose config >/dev/null; then
      green "compose 配置有效"
    else
      red "compose 配置无效"; fail=1
    fi
  fi
else
  printf '（未检测到 docker，跳过 compose 校验；运行期构建检查以编译为准）\n'
fi

step "2/4 代码测试：分支感知暂存/发布/回滚"
if "$PYTHON" -m unittest tests.test_model -v; then
  green "单元测试通过"
else
  red "单元测试失败"; exit 1
fi

step "3/4 在端口 ${PORT} 启动页面服务"
APP_HOST=127.0.0.1 APP_PORT="$PORT" TABLE_SIZE=128 \
  "$PYTHON" -m app.server &
SERVER_PID=$!

for _ in $(seq 1 50); do
  if "$PYTHON" - "$BASE_URL" <<'PY'
import sys, json, urllib.request
try:
    with urllib.request.urlopen(sys.argv[1] + "/health", timeout=1) as r:
        body = json.loads(r.read())
    sys.exit(0 if body.get("status") == "ok" else 1)
except Exception:
    sys.exit(1)
PY
  then
    green "健康检查就绪：${BASE_URL}/health"
    break
  fi
  sleep 0.2
done

if ! kill -0 "$SERVER_PID" 2>/dev/null; then
  red "服务启动失败"; exit 1
fi

step "4/4 页面与健康接口 API/HTTP 冒烟（条件切换/部分发布/失败回滚）"
if APP_BASE_URL="$BASE_URL" "$PYTHON" -m unittest tests.http_smoke -v; then
  green "HTTP 冒烟通过"
else
  red "HTTP 冒烟失败"; fail=1
fi

echo
if [ "$fail" -eq 0 ]; then
  green "✅ verify 验收通过：全部场景成功（退出码 0）"
else
  red "❌ verify 验收失败（退出码 1）"
fi
exit "$fail"
